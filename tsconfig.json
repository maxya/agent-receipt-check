{
  "compilerOptions": {
    "target": "es2023", "lib": ["es2023"], "module": "nodenext", "moduleResolution": "nodenext",
    "types": ["node"], "rootDir": "src", "outDir": "dist",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true, "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true, "declaration": false, "sourceMap": false,
    "verbatimModuleSyntax": true, "isolatedModules": true
  },
  "include": ["src"]
}
